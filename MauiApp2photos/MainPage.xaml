<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2photos.MainPage"
             Shell.NavBarIsVisible="False">
    
    
    <CollectionView x:Name="CosmeticCollection" Margin="10" SelectionMode="None">
        <!--Grid Layout with two columns-->
        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical" Span="2"/>
        </CollectionView.ItemsLayout>
        
        <!--Template for each item-->
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Padding="10" Margin="10" CornerRadius="10" HasShadow="True">

                    <!--Tap Gesture inside the frame-->
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                    </Frame.GestureRecognizers>


                    <StackLayout HorizontalOptions="Center">
                       <!--Images-->
                        <Image Source="{Binding Image}"
                               WidthRequest="100"
                               HeightRequest="100"
                               Aspect="AspectFill"/>

                        <!--Product Names-->
                        <Label  Text="{Binding Name}"
                                FontAttributes="Bold"
                                FontSize="16"
                                HorizontalOptions="Center"/>
                        
                        <!--Color-->
                        <Label Text="{Binding Color}"
                               FontSize="16"
                               TextColor="Red"
                               HorizontalOptions="Center"/>

                        <!--Price-->
                        <Label Text="{Binding Price, StringFormat='R{0:F2}'}"
                               FontSize="16"
                               TextColor="Green"
                               HorizontalOptions="Center"/>
                        
                    </StackLayout>
                    
                    
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        
    </CollectionView>


</ContentPage>
