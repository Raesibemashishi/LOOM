<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="logInn.ForgetPassword"
             Title="ForgetPassword"
             Shell.NavBarIsVisible="False">


    <Grid
       RowDefinitions="*,Auto">

        <!--Client Details-->
        <ListView Grid.Row="0"
                  x:Name="DisplayInfomation"
                  ItemsSource="{Binding clientDetails}"
                  HasUnevenRows="True"
                  ItemTapped="DisplayInfomation_ItemTapped">

            <ListView.ItemTemplate >
                <DataTemplate>
                    <ViewCell>
                        <VerticalStackLayout  Padding="10">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold"/>
                            <Label Grid.Column="1" Text="{Binding Email}" FontAttributes="Bold"/>
                            <Label Grid.Column="2" Text="{Binding Password}" FontAttributes="Bold"/>
                            </Grid>
                        </VerticalStackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

       <!--Edit, Delete, Save-->
        <VerticalStackLayout
            Grid.Row="1">
            <Entry
                Text="{Binding Name}"
                x:Name="NameEntryField"
                Placeholder="Name"/>
            <Entry
                Text="{Binding Email}"
                x:Name="EmailEntryField"
                Placeholder="Email"/>
            <Entry 
                Text="{Binding Password}"
                x:Name="PasswordEntryField"
                Placeholder="Password"/>
            <Button Text="Save"  x:Name="SaveButtn" Command="{Binding SaveEditedCommand}"  />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
    
