<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="logInn.ForgetPassword"
             Title="ForgetPassword"
             BackgroundColor="Purple" 
             Shell.NavBarIsVisible="False">
    
    
    <!--this page is used to read from the Database-->

    <Grid
       RowDefinitions="*,Auto">

        <!--Client Details-->
        <ListView Grid.Row="0"
                  x:Name="DisplayInfomation"
                  ItemsSource="{Binding ClientDetails}"
                  HasUnevenRows="True"
                  SelectedItem="{Binding SelectedClient}"
                >

            <ListView.ItemTemplate >
                <DataTemplate>
                    <ViewCell>
                        <VerticalStackLayout  Padding="10">
                            <Label
                                Text="Client Details"
                                FontAttributes="Bold"
                                FontSize="20"
                                Margin="10"/>
                            <Grid ColumnDefinitions="Auto,Auto, Auto"
                                  ColumnSpacing="15">
                            <Label Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   FontSize="10"
                                   HorizontalTextAlignment="Center"/>
                            <Label   Grid.Column="1"  
                                     Text="{Binding Email}"
                                     FontAttributes="Bold"
                                     FontSize="10"
                                    HorizontalOptions="End"/>
                            <Label   Grid.Column="2" 
                                     Text="{Binding Password}" 
                                     FontAttributes="Bold"
                                     FontSize="10"
                                     HorizontalOptions="End"/>
                            </Grid>
                        </VerticalStackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

       <!--Edit, Delete, Save-->
        <VerticalStackLayout
            Grid.Row="1">
            
            <Entry
                Text="{Binding Name}"
                x:Name="NameEntryField"
                Placeholder="Name"/>
            <Entry
                Text="{Binding Email}"
                x:Name="EmailEntryField"
                Placeholder="Email"/>
            <Entry 
                Text="{Binding Password}"
                x:Name="PasswordEntryField"
                Placeholder="Password"/>
            
            <Button Text="Save"  x:Name="SaveButtn" Command="{Binding SaveEditedCommand}"  />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
    
