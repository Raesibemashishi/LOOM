<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LOOM_APP.MainPage"
             Style="{StaticResource LoomPage}"
            Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout>
            <Image
                Source="loomlogo.png"
                HeightRequest="185"
                Aspect="AspectFit"/>

            <Label
                Text="Welcome to LOOM APP"
                FontSize="{StaticResource FontSizeLarge}"
                TextColor="Black"
                FontAttributes="Bold"
                HorizontalOptions="Center"/>

            <Button 
                Text="Get Started"
                Style="{StaticResource LoomButtom}"
                Clicked="Button_Clicked"
                TextColor="Black"
                ImageSource="fowardarrow.png"
                ContentLayout="Right,8"
                HeightRequest="50"
                WidthRequest="170"/>



        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
