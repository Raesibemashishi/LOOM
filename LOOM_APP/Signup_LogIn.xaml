<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LOOM_APP.Signup_LogIn"
             Title="Signup_LogIn"
             Style="{StaticResource LoomPage}"
              Shell.NavBarIsVisible="False">

  <Grid RowDefinitions="*,Auto">
   <ScrollView Grid.Row="0">
    <VerticalStackLayout>
       <!--logo-->
       <Image
         Source="loomlogo.png"
          HeightRequest="185"
          Aspect="AspectFit"/>
        <Button
            Text="Sign Up"
             HeightRequest="50"
            WidthRequest="170"
            FontSize="{StaticResource FontSizeMedium}"

            Style="{StaticResource LoomButtom}"
           />
        <Button
             Text="Log IN"
             HeightRequest="50"
             WidthRequest="170"
            FontSize="{StaticResource FontSizeMedium}"

              Style="{StaticResource LoomButtom}" 
                />
        <Label 
            Text="OR"
            TextColor="Black" HorizontalOptions="Center"/>

        <Button 
             Text="Sign using Google"
             Style="{StaticResource LoomButtom}"
             TextColor="Black"
             ImageSource="googleicon.png"
             ContentLayout="Right,8"
             HeightRequest="50"
             WidthRequest="170"/>


    </VerticalStackLayout>
   </ScrollView>
      <!--Back Button bottom left-->
        <ImageButton 
            Grid.Row="1"
            Source="backarrow.png"
            Style="{StaticResource BackButton}"
            HorizontalOptions="Start"
            VerticalOptions="End"
            Clicked="ImageButton_Clicked"/>
    </Grid>
</ContentPage>