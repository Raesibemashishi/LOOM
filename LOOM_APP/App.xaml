<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LOOM_APP"
             x:Class="LOOM_APP.App">
    
    
    <Application.Resources>
        <ResourceDictionary>
            <!--Standard Font Sizes-->
            <x:Double x:Key="FontSizeLarge">24</x:Double>
            <x:Double x:Key="FontSizeMedium">18</x:Double>
            <x:Double x:Key="FontSizeSmall">14</x:Double>
            
            <!--Standard Spacing-->
            <Thickness x:Key="PagePadding">20</Thickness>
            <Thickness x:Key="ElementSpacing">10</Thickness>
            
            <!--Reusable Button Style-->
            <Style TargetType="Button" x:Key="LoomButtom">
                <Setter Property="BackgroundColor" Value="#2E8B57" /> <!--Green-->
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}" />
                <Setter Property="Padding" Value="12.5" />
                <Setter Property="Margin" Value="{StaticResource ElementSpacing}" />
            </Style>
            <!--<Reusable ContentPage Style with Backround-->
                <Style TargetType="ContentPage" x:Key="LoomPage">
                    <Setter Property="BackgroundImageSource" Value="back.png"/>
                    <Setter Property="Padding" Value="{StaticResource PagePadding}"/>
            </Style>
            
            <!--Back button arrowimage-->
            <Style TargetType="ImageButton" x:Key="BackButton">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="HeightRequest" Value="40"/>
                <Setter Property="WidthRequest" Value="40"/>
                <Setter Property="CornerRadius" Value="20"/> <!--Makes it circular-->
            </Style>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
